<h2>Lista de Instrumentos</h2>

<form method="post">
    <input type="text" name="pesquisar" placeholder="Nome do instrumento">

    <input type="submit" value="Buscar">
</form>

<br>

<a href="/instrumento/add">
    Novo Instrumento
</a>

<hr>

<ul>
    <% instrumentos.forEach(i=> { %>

        <li>
            <strong>Nome:</strong>
            <%= i.nome %> |
                <strong>Fabricante:</strong>
                <%= i.fabricante %> |
                    <strong>Preço:</strong> R$ <%= i.preco %> |
                        <strong>Tipo:</strong>
                        <%= i.tipo %>
        </li>

        <% }) %>
</ul>